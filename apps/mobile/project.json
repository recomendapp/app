{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^generate"],
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p apps/mobile/tsconfig.app.json"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "command": "expo start --port 19004" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "APP_VARIANT=development nx start mobile --dev-client" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "APP_VARIANT=development nx start mobile --dev-client --clear"
      }
    },
    "dev-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "APP_VARIANT=development nx run-ios mobile --port 19004"
      }
    },
    "dev-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "APP_VARIANT=development nx run-android mobile --port 19004"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/mobile",
        "command": "expo prebuild"
      }
    },
    "update": {
      "command": "eas update",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"]
    }
  }
}
