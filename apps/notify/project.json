{
  "name": "notify",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/notify/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^generate"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/notify"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "generate-bun-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/bun.lock"],
      "outputs": ["{workspaceRoot}/dist/apps/notify/bun.lock"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun install --cwd=dist/apps/notify --lockfile-only"
      }
    },
    "prune": {
      "dependsOn": ["generate-bun-lockfile"],
      "executor": "nx:noop"
    },
    "docker-build": {
      "dependsOn": ["build", "^build", "prune"]
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "notify:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "notify:build:development"
        },
        "production": {
          "buildTarget": "notify:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/notify-integration"],
      "options": {
        "jestConfig": "apps/notify/jest.integration.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
