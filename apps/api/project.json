{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "generate-openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^generate"],
      "outputs": ["{projectRoot}/.openapi/*"],
      "inputs": [
        "default",
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/tsconfig.app.json"
      ],
      "options": {
        "command": "bunx ts-node -r tsconfig-paths/register --project apps/api/tsconfig.app.json apps/api/scripts/generate-openapi.ts",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^generate"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "generate-bun-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tools/scripts/prune-bun-lockfile.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/bun.lock"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/prune-bun-lockfile.mjs dist/apps/api"
      }
    },
    "prune": {
      "dependsOn": ["generate-bun-lockfile"],
      "executor": "nx:noop"
    },
    "docker-build": {
      "dependsOn": ["build", "^build", "prune"]
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/api",
        "parallel": true,
        "commands": [
          "webpack-cli build --node-env=development --watch --no-output-clean",
          "bun --watch --no-clear-screen ../../dist/apps/api/main.js"
        ]
      },
      "configurations": {
        "development": {},
        "production": {
          "commands": [
            "webpack-cli build --node-env=production --watch --no-output-clean",
            "bun --watch --no-clear-screen ../../dist/apps/api/main.js"
          ]
        }
      }
    },
    "mcp-inspector": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "HOST=localhost bunx @modelcontextprotocol/inspector --web --transport http --server-url http://localhost:9000/mcp"
      },
      "configurations": {
        "cli": {
          "command": "HOST=localhost bunx @modelcontextprotocol/inspector --cli --transport http --server-url http://localhost:9000/mcp"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun test --parallel --no-env-file --path-ignore-patterns=\"**/*.integration.spec.ts\""
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --no-env-file ../../libs/testing/src/lib/db/run-integration-tests.ts --isolate --no-env-file --timeout 60000 --preload ./src/test-setup.integration.ts integration.spec"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
